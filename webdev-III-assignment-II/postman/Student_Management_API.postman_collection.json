{
  "info": {
    "_postman_id": "25010101-0098-4a22-8a2a-250101011010",
    "name": "Student Management REST API - Yuvraj Singh Soni",
    "description": "Lab Assignment 2 | Roll No. 2501010098 | CRUD API testing collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "studentId", "value": "1" }
  ],
  "item": [
    {
      "name": "GET - Get All Students",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/students" }
    },
    {
      "name": "GET - Get Student by ID",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/students/{{studentId}}" }
    },
    {
      "name": "POST - Create Student",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) {", "  const response = pm.response.json();", "  pm.collectionVariables.set('studentId', response.data.id);", "}"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Yuvraj Singh Soni\",\n  \"age\": 20,\n  \"course\": \"B.Tech CSE\",\n  \"email\": \"yuvraj@example.com\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/students"
      }
    },
    {
      "name": "PUT - Update Student",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Yuvraj Singh Soni Updated\",\n  \"age\": 20,\n  \"course\": \"B.Tech CSE\",\n  \"email\": \"yuvraj.updated@example.com\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/students/{{studentId}}"
      }
    },
    {
      "name": "DELETE - Delete Student",
      "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/students/{{studentId}}" }
    },
    {
      "name": "GET - Student Not Found (404)",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/students/99999" }
    },
    {
      "name": "POST - Invalid Student Data (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"age\": -2,\n  \"course\": \"\",\n  \"email\": \"not-an-email\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/students"
      }
    }
  ]
}
